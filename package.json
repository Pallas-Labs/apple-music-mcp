{
  "name": "@pallas-labs/apple-music-mcp",
  "version": "0.2.0",
  "description": "MCP server for controlling Apple Music on macOS via AppleScript",
  "keywords": [
    "apple-music",
    "applescript",
    "macos",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "Parth Mangrola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmangrola/apple-music-mcp.git"
  },
  "bin": {
    "apple-music-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src .github --deny-warnings",
    "lint:fix": "oxlint src .github --deny-warnings --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "bun run format:check && bun run lint && bun run typecheck && bun test src && bun run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "INTEGRATION=true bun test src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "express-rate-limit": "8.2.2",
    "fast-uri": "3.1.2",
    "hono": "4.12.25",
    "ip-address": "10.2.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
